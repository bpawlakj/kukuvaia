# ============================================================================
# kukuvaia-engine — environment variables
#
# Copy to .env (same directory) and adjust. `./gradlew :kukuvaia-app:bootRun`
# loads this file automatically. Never commit .env.
#
#   cp kukuvaia-engine/.env.example kukuvaia-engine/.env
#
# REQUIRED: PostgreSQL + LLM provider (see blocks below).
# ============================================================================

# ---- PostgreSQL — REQUIRED -------------------------------------------------
# Engine will not start without a reachable DB. Defaults match docker-compose.yml.
PG_DSN=jdbc:postgresql://localhost:5432/kukuvaia
PG_USER=kukuvaia
PG_PASSWORD=kukuvaia

# ---- LLM provider — REQUIRED -----------------------------------------------
# Provider config is now file-based (kukuvaia.llm-providers in application.yaml).
# Set these env vars; they are interpolated into the YAML at startup.
# No admin UI or REST API call needed.

# Anthropic (default). Replace with your key.
ANTHROPIC_API_KEY=sk-ant-...

# Endpoint and model. Defaults work for Anthropic; change for OpenAI-compatible.
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6

# ============================================================================
# Everything below is OPTIONAL.
# ============================================================================

# ---- Provider type (if not Anthropic) --------------------------------------
# PROVIDER_NAME=openrouter
# PROVIDER_TYPE=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ---- HTTP / LLM client tuning ----------------------------------------------
# PORT=8080
# LLM_CONNECT_TIMEOUT=10s
# LLM_READ_TIMEOUT=120s

# ---- Model display + limits ------------------------------------------------
# LLM_MODEL_DISPLAY=Claude Sonnet 4.6
# LLM_MODEL_TIER=standard
# LLM_MAX_TOKENS=8096

# ---- Embeddings ------------------------------------------------------------
# false (default) = local ONNX (MiniLM-L6-v2, auto-downloaded once, ~90 MB).
# OPENAI_EMBEDDING_ENABLED=false

# ---- Memory consolidation cron ---------------------------------------------
# MEMORY_CONSOLIDATION_CRON=0 0 3 * * *

# ---- Production hardening --------------------------------------------------
# KUKUVAIA_SECURITY_DEV_MODE=false
# WEBHOOK_SECRET=
