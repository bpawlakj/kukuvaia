# ============================================================================
# kukuvaia-engine — environment variables
#
# This file belongs next to `build.gradle` in the engine root. Copy it to
# `.env` (same directory) and adjust values. The Gradle `bootRun` task loads
# this file automatically. Never commit `.env`.
#
#   cp kukuvaia-engine/.env.example kukuvaia-engine/.env
#   # or, from repo root:
#   ./scripts/bootstrap.sh
#
# Defaults below match `kukuvaia-engine/docker-compose.yml`. CLI-specific
# variables (KUKUVAIA_SERVER_URL, KUKUVAIA_PERSONA, KUKUVAIA_SESSION) are
# consumed by the Go binary — export them from your shell, not from here.
#
# LLM_API_KEY is the only source of the API key — there is no credentials file.
# ============================================================================

# ---- PostgreSQL ------------------------------------------------------------
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in docker-compose.yml.
PG_DSN=jdbc:postgresql://localhost:5432/kukuvaia
PG_USER=kukuvaia
PG_PASSWORD=kukuvaia

# ---- HTTP server -----------------------------------------------------------
PORT=8080

# ---- LLM provider ----------------------------------------------------------
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=not-used
LLM_MODEL=claude-sonnet-4.5
LLM_CONNECT_TIMEOUT=10s
LLM_READ_TIMEOUT=120s

# ---- Embeddings ------------------------------------------------------------
# false = local ONNX (MiniLM-L6-v2, auto-downloaded once, ~90 MB).
# true  = use the OpenAI-compatible remote embedding endpoint at LLM_BASE_URL.
OPENAI_EMBEDDING_ENABLED=false

# ---- Memory consolidation --------------------------------------------------
MEMORY_CONSOLIDATION_CRON=0 0 3 * * *

# ---- Security / webhooks ---------------------------------------------------
# Leave empty for local dev. Required for /api/webhooks/* HMAC validation in prod.
WEBHOOK_SECRET=
# true relaxes auth on /api/* for local dev. Set to false in any shared environment.
KUKUVAIA_SECURITY_DEV_MODE=true
