# ============================================================================
# kukuvaia-engine — environment variables
#
# Copy to .env (same directory) and adjust. `./gradlew :kukuvaia-app:bootRun`
# loads this file automatically. Never commit .env.
#
#   cp kukuvaia-engine/.env.example kukuvaia-engine/.env
#   # or, from repo root:
#   ./scripts/bootstrap.sh
#
# Only the PostgreSQL block is required. Everything else has sensible defaults
# or is configured via the admin dashboard (Providers / Models / Roles) after
# first boot. See README §5 "Register provider, models, and role assignments".
# ============================================================================

# ---- PostgreSQL — REQUIRED -------------------------------------------------
# Engine will not start without a reachable DB. Defaults match docker-compose.yml.
PG_DSN=jdbc:postgresql://localhost:5432/kukuvaia
PG_USER=kukuvaia
PG_PASSWORD=kukuvaia

# ============================================================================
# Everything below is OPTIONAL. Uncomment only what you need.
# ============================================================================

# ---- First-boot provider seed ----------------------------------------------
# If set on the very first startup (empty providers table), seeds a default
# provider/model/role from these vars. After that, manage providers through
# the admin dashboard at http://localhost:5173 — these vars become ignored.
#
# Skip this block entirely if you prefer to add the first provider through
# the admin UI by hand.
#
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5

# ---- Provider API keys referenced from the admin dashboard ------------------
# When you create a provider in the admin UI you set `apiKeyRef = "<ENV_NAME>"`.
# The DB stores only the env-var NAME; the literal token must live here (or in
# the deploy host's environment). Add as many as you have providers for.
#
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# SMARTGATE_API_KEY=<jwt>

# ---- HTTP / LLM client tuning ----------------------------------------------
# PORT=8080
# LLM_CONNECT_TIMEOUT=10s
# LLM_READ_TIMEOUT=120s

# ---- Embeddings ------------------------------------------------------------
# false (default) = local ONNX (MiniLM-L6-v2, auto-downloaded once, ~90 MB).
# true            = use the OpenAI-compatible remote embedding endpoint.
# OPENAI_EMBEDDING_ENABLED=false

# ---- Memory consolidation cron ---------------------------------------------
# Default runs nightly at 03:00. Override if you need a different cadence.
# MEMORY_CONSOLIDATION_CRON=0 0 3 * * *

# ---- Production hardening --------------------------------------------------
# Default is dev-mode (true) — auth is relaxed on /api/*. Set to false in any
# shared / staging / production environment.
# KUKUVAIA_SECURITY_DEV_MODE=false
#
# Required only if /api/webhooks/* is used (HMAC validation). Random 32+ chars.
# WEBHOOK_SECRET=
